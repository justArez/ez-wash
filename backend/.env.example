# Supabase / PostgreSQL Connection String
# For Transaction pooler (Port 6543) or Session pooler (Port 5432)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Admin Authentication Token
ADMIN_TOKEN="[YOUR_ADMIN_TOKEN]"
PORT=3000

# Supabase Storage (S3-compatible) — used server-side only to upload
# seat-deposit payment slips. Get these from Project Settings > Storage > S3
# Connection on the Supabase dashboard. NEVER expose these to the frontend.
SUPABASE_S3_ENDPOINT="https://[YOUR_PROJECT_REF].storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="[YOUR_REGION]"
SUPABASE_S3_ACCESS_KEY_ID="[YOUR_S3_ACCESS_KEY_ID]"
SUPABASE_S3_SECRET_ACCESS_KEY="[YOUR_S3_SECRET_ACCESS_KEY]"

# Bucket must be public (or have a public read policy) so slip images can be
# viewed by customers/admins via the returned public URL.
SUPABASE_STORAGE_BUCKET="seat-deposits"

# Project base URL, used to build the public object URL after upload.
SUPABASE_PUBLIC_URL="https://[YOUR_PROJECT_REF].supabase.co"

# Optional: Project Settings > API > service_role secret. If set, the
# backend auto-creates/marks the bucket above as public on first upload.
# Otherwise, mark the bucket Public manually in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# JWT_SECRET is used to sign and verify JWT tokens for authentication. It should be a long, random string.
# Make sure to replace this with a secure value in production.
JWT_SECRET="[YOUR_JWT_SECRET]"